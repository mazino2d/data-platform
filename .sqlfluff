[sqlfluff]
dialect = bigquery
# The jinja templater with dbt builtins lints without a warehouse connection;
# the dbt templater would need BigQuery credentials just to compile.
templater = jinja
# RF02: reference qualification — disabled because dbt ref() calls are unqualified
exclude_rules = RF02
max_line_length = 120
sql_file_exts = .sql

[sqlfluff:templater:jinja]
apply_dbt_builtins = True
load_macros_from_path = ./dbt/macros

[sqlfluff:rules:layout.indent]
indent_unit = space
tab_space_size = 4

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.identifiers]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.functions]
capitalisation_policy = upper
