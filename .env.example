# BigQuery project; credentials come from `gcloud auth application-default login`.
GCP_PROJECT_ID=dataplatform-as-se1-dev
# Firestore the simsplit source copies from.
SIMSPLIT_FIREBASE_PROJECT=simsplit-as-se1-dev
# dev writes to dev_$USER_* datasets, prod to the bare <project>_<layer> datasets.
DBT_TARGET=dev
